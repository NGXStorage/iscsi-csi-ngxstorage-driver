# Copy to config.env and fill in the target cluster and storage details.
# Runtime environment values take precedence. config.env is ignored by Git.
# BENCH=ocp2 selects oc; BENCH=k8s selects kubectl. KUBE_BIN can override it.
BENCH="${BENCH:-}"
KUBECONFIG="${KUBECONFIG:-}"
# Optional: refuse to run if the kubeconfig's current context differs.
KUBE_CONTEXT="${KUBE_CONTEXT:-}"
CSI_DRIVER_NAMESPACE="${CSI_DRIVER_NAMESPACE:-}"
NAMESPACE="${NAMESPACE:-default}"
NGX_CONTROLLER="${NGX_CONTROLLER:-}"
NGX_POOL_NAME="${NGX_POOL_NAME:-}"
# Supply the key at runtime or set it only in the ignored config.env.
STORAGE_API_KEY="${STORAGE_API_KEY:-}"
# Optional: NFS data address, SDK CLI path, or Kubernetes CLI override.
NGX_DATA_IP="${NGX_DATA_IP:-}"
NGX_SDK_CLI="${NGX_SDK_CLI:-}"
KUBE_BIN="${KUBE_BIN:-}"
